generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Location {
  id              String                    @id @default(cuid())
  name            String                    @unique
  address         String
  phone           String?
  timezone        String                    @default("America/Los_Angeles")
  active          Boolean                   @default(true)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  customers       Customer[]
  frameInventory  FrameInventory[]
  inventory       Inventory[]
  productSettings LocationProductSettings[]
  products        ProductLocation[]
  purchaseOrders  PurchaseOrder[]
  transactions    Transaction[]
  users           User[]

  @@map("locations")
}

model User {
  id                 String              @id @default(cuid())
  email              String?
  passwordHash       String?
  role               UserRole            @default(ASSOCIATE)
  locationId         String
  firstName          String
  lastName           String
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  username           String?             @unique
  inventoryMovements InventoryMovement[]
  purchaseOrders     PurchaseOrder[]
  transactions       Transaction[]
  location           Location            @relation(fields: [locationId], references: [id])

  @@map("users")
}

model InsuranceCarrier {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  active    Boolean  @default(true)
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("insurance_carriers")
}

model ProductCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  code        String    @unique
  description String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("product_categories")
}

model Product {
  id                 String              @id @default(cuid())
  name               String
  sku                String?             @unique
  categoryId         String
  manufacturer       String?
  basePrice          Float
  tierVsp            String?
  tierEyemed         String?
  tierSpectera       String?
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  inventory          Inventory[]
  locations          ProductLocation[]
  suppliers          ProductSupplier[]
  category           ProductCategory     @relation(fields: [categoryId], references: [id])
  purchaseOrderItems PurchaseOrderItem[]
  transactionItems   TransactionItem[]

  @@map("products")
}

model ProductLocation {
  id            String   @id @default(cuid())
  productId     String
  locationId    String
  priceOverride Float?
  available     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  location      Location @relation(fields: [locationId], references: [id])
  product       Product  @relation(fields: [productId], references: [id])

  @@unique([productId, locationId])
  @@map("product_locations")
}

model Customer {
  id                       String                    @id @default(cuid())
  firstName                String
  lastName                 String
  email                    String?
  phone                    String?
  dateOfBirth              DateTime?
  gender                   Gender?
  address                  String?
  city                     String?
  state                    String?
  zipCode                  String?
  insuranceCarrier         String?
  memberId                 String?
  groupNumber              String?
  eligibilityDate          DateTime?
  active                   Boolean                   @default(true)
  customerNumber           String?                   @unique
  accountStatus            AccountStatus             @default(ACTIVE)
  registrationDate         DateTime                  @default(now())
  lastVisit                DateTime?
  totalSpent               Float                     @default(0)
  averageOrderValue        Float                     @default(0)
  customerLifetimeValue    Float                     @default(0)
  lastPurchaseDate         DateTime?
  isHighValueCustomer      Boolean                   @default(false)
  isFrequentCustomer       Boolean                   @default(false)
  riskLevel                RiskLevel                 @default(LOW)
  marketingConsent         Boolean                   @default(false)
  notes                    String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  createdBy                String?
  updatedBy                String?
  primaryLocationId        String?
  communicationPreferences CommunicationPreferences?
  addresses                CustomerAddress[]
  insuranceInfo            CustomerInsurance[]
  preferences              CustomerPreferences?
  purchaseHistory          CustomerPurchaseHistory[]
  relationships            CustomerRelationship[]    @relation("PrimaryCustomer")
  relatedTo                CustomerRelationship[]    @relation("RelatedCustomer")
  tags                     CustomerTagAssignment[]
  visitHistory             CustomerVisit[]
  primaryLocation          Location?                 @relation(fields: [primaryLocationId], references: [id])
  prescriptions            EyePrescription[]
  eyewearPreferences       EyewearPreferences?
  insuranceCases           InsuranceCase[]
  insuranceDocuments       InsuranceDocument[]
  quotes                   Quote[]
  transactions             Transaction[]
  orders                   Order[]                   @relation("CustomerOrders")

  @@map("customers")
}

model CustomerAddress {
  id         String      @id @default(cuid())
  customerId String
  type       AddressType
  street     String
  street2    String?
  city       String
  state      String
  zipCode    String
  country    String      @default("USA")
  isPrimary  Boolean     @default(false)
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  customer   Customer    @relation(fields: [customerId], references: [id])

  @@map("customer_addresses")
}

model CustomerInsurance {
  id                       String            @id @default(cuid())
  customerId               String
  carrier                  String
  planName                 String?
  planType                 InsurancePlanType
  memberId                 String
  groupNumber              String?
  effectiveDate            DateTime
  expirationDate           DateTime?
  copayAmount              Float?
  deductible               Float?
  isPrimary                Boolean           @default(false)
  isActive                 Boolean           @default(true)
  subscriberName           String?
  relationshipToSubscriber RelationshipType?
  coverageDetails          Json
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  customer                 Customer          @relation(fields: [customerId], references: [id])

  @@map("customer_insurance")
}

model CustomerPreferences {
  id                        String        @id @default(cuid())
  customerId                String        @unique
  preferredContactMethod    ContactMethod @default(EMAIL)
  appointmentReminders      Boolean       @default(true)
  promotionalEmails         Boolean       @default(false)
  language                  String        @default("en")
  timezone                  String        @default("America/New_York")
  preferredBrands           Json          @default("[]")
  budgetRange               Json?
  largeFont                 Boolean       @default(false)
  audioAssistance           Boolean       @default(false)
  wheelchairAccessible      Boolean       @default(false)
  preferredProviders        Json          @default("[]")
  preferredAppointmentTimes Json          @default("[]")
  specialInstructions       String?
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
  customer                  Customer      @relation(fields: [customerId], references: [id])

  @@map("customer_preferences")
}

model EyewearPreferences {
  id                 String   @id @default(cuid())
  customerId         String   @unique
  frameStyles        Json     @default("[]")
  frameMaterials     Json     @default("[]")
  frameColors        Json     @default("[]")
  lensTypes          Json     @default("[]")
  lensCoatings       Json     @default("[]")
  contactLensBrands  Json     @default("[]")
  contactLensTypes   Json     @default("[]")
  framesBudget       Float?
  contactsBudget     Float?
  safetyRequirements Boolean  @default(false)
  computerGlasses    Boolean  @default(false)
  sportsEyewear      Boolean  @default(false)
  fashionPriority    Priority @default(MEDIUM)
  comfortPriority    Priority @default(HIGH)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  customer           Customer @relation(fields: [customerId], references: [id])

  @@map("eyewear_preferences")
}

model CommunicationPreferences {
  id                    String   @id @default(cuid())
  customerId            String   @unique
  emailAppointments     Boolean  @default(true)
  emailPromotions       Boolean  @default(false)
  emailReminders        Boolean  @default(true)
  emailNewsletters      Boolean  @default(false)
  smsAppointments       Boolean  @default(true)
  smsPickupReady        Boolean  @default(true)
  smsPromotions         Boolean  @default(false)
  phoneAppointments     Boolean  @default(false)
  phoneFollowUp         Boolean  @default(false)
  phoneEmergencyContact Boolean  @default(true)
  mailingStatements     Boolean  @default(true)
  mailingPromotions     Boolean  @default(false)
  mailingCatalogs       Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  customer              Customer @relation(fields: [customerId], references: [id])

  @@map("communication_preferences")
}

model CustomerRelationship {
  id                String                   @id @default(cuid())
  primaryCustomerId String
  relatedCustomerId String
  relationshipType  CustomerRelationshipType
  isActive          Boolean                  @default(true)
  notes             String?
  createdAt         DateTime                 @default(now())
  primaryCustomer   Customer                 @relation("PrimaryCustomer", fields: [primaryCustomerId], references: [id])
  relatedCustomer   Customer                 @relation("RelatedCustomer", fields: [relatedCustomerId], references: [id])

  @@unique([primaryCustomerId, relatedCustomerId])
  @@map("customer_relationships")
}

model CustomerPurchaseHistory {
  id               String   @id @default(cuid())
  customerId       String
  transactionId    String
  orderDate        DateTime
  totalAmount      Float
  paymentMethod    String
  prescriptionUsed String?
  providerId       String?
  itemsJson        String   @default("[]")
  createdAt        DateTime @default(now())
  customer         Customer @relation(fields: [customerId], references: [id])

  @@map("customer_purchase_history")
}

model CustomerVisit {
  id                         String    @id @default(cuid())
  customerId                 String
  visitDate                  DateTime
  visitType                  VisitType
  providerId                 String?
  providerName               String?
  duration                   Int?
  notes                      String?
  outcome                    String?
  nextAppointmentRecommended Boolean   @default(false)
  createdAt                  DateTime  @default(now())
  customer                   Customer  @relation(fields: [customerId], references: [id])

  @@map("customer_visits")
}

model EyePrescription {
  id                String           @id @default(cuid())
  customerId        String
  prescriptionDate  DateTime
  providerId        String?
  providerName      String?
  rightEyeJson      String           @default("{}")
  leftEyeJson       String           @default("{}")
  pupillaryDistance Float?
  bifocalHeight     Float?
  prescriptionType  PrescriptionType
  notes             String?
  expirationDate    DateTime?
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  customer          Customer         @relation(fields: [customerId], references: [id])

  @@map("eye_prescriptions")
}

model CustomerTag {
  id          String                  @id @default(cuid())
  name        String                  @unique
  color       String?
  category    TagCategory?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  assignments CustomerTagAssignment[]

  @@map("customer_tags")
}

model CustomerTagAssignment {
  id         String      @id @default(cuid())
  customerId String
  tagId      String
  createdAt  DateTime    @default(now())
  customer   Customer    @relation(fields: [customerId], references: [id])
  tag        CustomerTag @relation(fields: [tagId], references: [id])

  @@unique([customerId, tagId])
  @@map("customer_tag_assignments")
}

model Quote {
  id              String      @id @default(cuid())
  customerId      String
  authorizationId String?
  status          QuoteStatus @default(DRAFT)
  quoteNumber     String      @unique @default(cuid())
  retailTotal     Float
  insuranceTotal  Float       @default(0)
  patientTotal    Float
  tax             Float       @default(0)
  grandTotal      Float
  items           Json
  examItems       Json?
  secondPair      Json?
  contactLenses   Json?
  notes           String?
  expiresAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  createdBy       String?
  customer        Customer    @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([status])
  @@index([quoteNumber])
  @@map("quotes")
}

model Transaction {
  id                String            @id @default(cuid())
  customerId        String
  userId            String
  locationId        String
  subtotal          Float
  tax               Float
  discount          Float             @default(0)
  total             Float
  insuranceCarrier  String?
  insuranceDiscount Float             @default(0)
  patientPortion    Float
  status            TransactionStatus @default(PENDING)
  paymentMethod     String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  items             TransactionItem[]
  customer          Customer          @relation(fields: [customerId], references: [id])
  location          Location          @relation(fields: [locationId], references: [id])
  user              User              @relation(fields: [userId], references: [id])

  @@map("transactions")
}

model TransactionItem {
  id                String      @id @default(cuid())
  transactionId     String
  productId         String
  quantity          Int         @default(1)
  unitPrice         Float
  discount          Float       @default(0)
  total             Float
  insuranceTier     String?
  insuranceDiscount Float       @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  product           Product     @relation(fields: [productId], references: [id])
  transaction       Transaction @relation(fields: [transactionId], references: [id])

  @@map("transaction_items")
}

model Inventory {
  id              String              @id @default(cuid())
  productId       String
  locationId      String
  currentStock    Int                 @default(0)
  reservedStock   Int                 @default(0)
  availableStock  Int                 @default(0)
  reorderPoint    Int                 @default(5)
  reorderQuantity Int                 @default(20)
  maxStock        Int?
  costPrice       Float?
  lastCostPrice   Float?
  lastRestocked   DateTime?
  lastSold        DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  location        Location            @relation(fields: [locationId], references: [id])
  product         Product             @relation(fields: [productId], references: [id])
  movements       InventoryMovement[]

  @@unique([productId, locationId])
  @@map("inventory")
}

model InventoryMovement {
  id            String       @id @default(cuid())
  inventoryId   String
  type          MovementType
  quantity      Int
  reason        String?
  referenceType String?
  referenceId   String?
  unitCost      Float?
  userId        String?
  notes         String?
  createdAt     DateTime     @default(now())
  inventory     Inventory    @relation(fields: [inventoryId], references: [id])
  user          User?        @relation(fields: [userId], references: [id])

  @@map("inventory_movements")
}

model Supplier {
  id             String            @id @default(cuid())
  name           String            @unique
  contactName    String?
  email          String?
  phone          String?
  address        String?
  city           String?
  state          String?
  zipCode        String?
  country        String            @default("USA")
  website        String?
  taxId          String?
  paymentTerms   String?
  active         Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  products       ProductSupplier[]
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model ProductSupplier {
  id            String   @id @default(cuid())
  productId     String
  supplierId    String
  supplierSku   String?
  supplierPrice Float?
  leadTimeDays  Int?
  minimumOrder  Int      @default(1)
  isPrimary     Boolean  @default(false)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  product       Product  @relation(fields: [productId], references: [id])
  supplier      Supplier @relation(fields: [supplierId], references: [id])

  @@unique([productId, supplierId])
  @@map("product_suppliers")
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  supplierId   String
  locationId   String
  userId       String
  orderNumber  String              @unique
  status       PurchaseOrderStatus @default(PENDING)
  subtotal     Float
  tax          Float               @default(0)
  shipping     Float               @default(0)
  total        Float
  orderDate    DateTime            @default(now())
  expectedDate DateTime?
  receivedDate DateTime?
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  items        PurchaseOrderItem[]
  location     Location            @relation(fields: [locationId], references: [id])
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  user         User                @relation(fields: [userId], references: [id])

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String        @id @default(cuid())
  purchaseOrderId  String
  productId        String
  quantityOrdered  Int
  quantityReceived Int           @default(0)
  unitCost         Float
  total            Float
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  product          Product       @relation(fields: [productId], references: [id])
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  @@map("purchase_order_items")
}

model InsurancePlanBenefit {
  id              String                    @id @default(cuid())
  carrierId       String
  carrierCode     String
  planName        String
  categoryId      String
  categoryCode    String
  tier            String
  tierLabel       String?
  allowance       Float?
  copay           Float?
  discountPercent Float?
  frequency       Int?
  notes           String?
  active          Boolean                   @default(true)
  effectiveDate   DateTime                  @default(now())
  expirationDate  DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  productPricing  ProductInsurancePricing[]

  @@unique([carrierCode, planName, categoryCode, tier])
  @@map("insurance_plan_benefits")
}

model ProductInsurancePricing {
  id                 String               @id @default(cuid())
  productId          String
  planBenefitId      String
  retailPrice        Float
  allowance          Float?
  patientCopay       Float
  insurancePays      Float
  overridePrice      Float?
  overrideReason     String?
  overrideBy         String?
  overrideDate       DateTime?
  active             Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  customerPriceLists CustomerPriceList[]
  planBenefit        InsurancePlanBenefit @relation(fields: [planBenefitId], references: [id])

  @@unique([productId, planBenefitId])
  @@map("product_insurance_pricing")
}

model CustomerPriceList {
  id                  String                   @id @default(cuid())
  customerId          String
  productId           String
  pricingId           String?
  finalPrice          Float
  retailPrice         Float
  savings             Float
  insuranceCarrier    String?
  planName            String?
  tier                String?
  validFrom           DateTime                 @default(now())
  validUntil          DateTime?
  customPrice         Float?
  priceOverrideReason String?
  priceOverrideBy     String?
  priceOverrideDate   DateTime?
  active              Boolean                  @default(true)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  pricing             ProductInsurancePricing? @relation(fields: [pricingId], references: [id])

  @@unique([customerId, productId])
  @@index([customerId, active])
  @@index([productId])
  @@map("customer_price_lists")
}

model VspProgressiveFormulary {
  productId      String  @id @map("product_id")
  brand          String
  productName    String  @map("product_name")
  tier           String
  tierName       String  @map("tier_name")
  isCustomizable Boolean @default(false) @map("is_customizable")
  baseCode       String  @map("base_code")
  designType     String? @map("design_type")

  @@map("vsp_progressive_formulary")
}

model VspArCoatingFormulary {
  productId     String  @id @map("product_id")
  brand         String
  productName   String  @map("product_name")
  vspTier       String  @map("vsp_tier")
  tierName      String  @map("tier_name")
  code          String
  hasBlueLight  Boolean @default(false) @map("has_blue_light")
  warrantyYears Int?    @map("warranty_years")

  @@map("vsp_ar_coating_formulary")
}

model EyemedProgressiveFormulary {
  productId      String  @id @map("product_id")
  brand          String
  productName    String  @map("product_name")
  tier           String
  isDigital      Boolean @default(false) @map("is_digital")
  isShort        Boolean @default(false) @map("is_short")
  isWrap         Boolean @default(false) @map("is_wrap")
  isOccupational Boolean @default(false) @map("is_occupational")
  designType     String? @map("design_type")

  @@map("eyemed_progressive_formulary")
}

model EyemedArCoatingFormulary {
  productId      String  @id @map("product_id")
  brand          String
  productName    String  @map("product_name")
  tier           String
  hasBlueLight   Boolean @default(false) @map("has_blue_light")
  isBacksideOnly Boolean @default(false) @map("is_backside_only")
  isSunSpecific  Boolean @default(false) @map("is_sun_specific")

  @@map("eyemed_ar_coating_formulary")
}

model SpecteraProgressiveFormulary {
  productId   String  @id @map("product_id")
  brand       String
  productName String  @map("product_name")
  tier        String
  isDigital   Boolean @default(false) @map("is_digital")
  isRayBan    Boolean @default(false) @map("is_ray_ban")
  isShort     Boolean @default(false) @map("is_short")
  designType  String? @map("design_type")

  @@map("spectera_progressive_formulary")
}

model SpecteraArCoatingFormulary {
  productId       String  @id @map("product_id")
  brand           String
  productName     String  @map("product_name")
  tier            String
  hasBlueLight    Boolean @default(false) @map("has_blue_light")
  hasMirrorOption Boolean @default(false) @map("has_mirror_option")
  hasUvBackside   Boolean @default(false) @map("has_uv_backside")
  isRayBan        Boolean @default(false) @map("is_ray_ban")

  @@map("spectera_ar_coating_formulary")
}

model PracticeData {
  practiceId       String @id @map("practice_id")
  practiceName     String @map("practice_name")
  vspUcPrices      Json   @default("{}") @map("vsp_uc_prices")
  specteraUcPrices Json   @default("{}") @map("spectera_uc_prices")
  eyemedUcPrices   Json   @default("{}") @map("eyemed_uc_prices")
  vspBundles       Json   @default("[]") @map("vsp_bundles")
  specteraBundles  Json   @default("[]") @map("spectera_bundles")
  eyemedBundles    Json   @default("[]") @map("eyemed_bundles")

  @@map("practice_data")
}

model InsuranceCase {
  id             String              @id @default(cuid())
  customerId     String?
  mergedData     Json?
  mergedAt       DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  externalCaseId String?             @unique
  customer       Customer?           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  documents      InsuranceDocument[]

  @@index([customerId])
  @@map("insurance_cases")
}

model InsuranceDocument {
  id                String         @id @default(cuid())
  customerId        String?
  caseId            String?
  documentType      DocumentType   @default(INSURANCE_CARD_FRONT)
  fileName          String
  fileType          String
  filePath          String
  fileSize          Int
  uploadedBy        String
  rawOcrText        String?
  ocrProcessedAt    DateTime?
  ocrStatus         String         @default("pending")
  ocrError          String?
  carrier           String?
  planName          String?
  memberId          String?
  groupNumber       String?
  copayExam         Decimal?       @db.Decimal(10, 2)
  copayMaterials    Decimal?       @db.Decimal(10, 2)
  frameAllowance    Decimal?       @db.Decimal(10, 2)
  lensAllowance     Decimal?       @db.Decimal(10, 2)
  contactAllowance  Decimal?       @db.Decimal(10, 2)
  networkTier       String?
  effectiveDate     DateTime?
  expirationDate    DateTime?
  gptProcessedAt    DateTime?
  gptStatus         String         @default("pending")
  gptError          String?
  confidenceScore   Float?
  extractedData     Json?
  verifiedBy        String?
  verifiedAt        DateTime?
  isVerified        Boolean        @default(false)
  verificationNotes String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  case              InsuranceCase? @relation(fields: [caseId], references: [id])
  customer          Customer?      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([caseId])
  @@index([carrier])
  @@index([isVerified])
  @@index([ocrStatus])
  @@index([gptStatus])
  @@index([createdAt])
  @@map("insurance_documents")
}

model LensProduct {
  id              String            @id @default(cuid())
  name            String
  category        LensCategory
  wholesaleCost   Float?
  multiplier      Float             @default(3.0)
  retailPrice     Float
  manufacturer    String?
  sku             String?           @unique
  description     String?
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  showInPos       Boolean           @default(true)
  isFeatured      Boolean           @default(false)
  posDisplayOrder Int               @default(999)
  isPreferred     Boolean           @default(false)
  carrierTiers    LensCarrierTier[]

  @@index([category])
  @@index([name])
