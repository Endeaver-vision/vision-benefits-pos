generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Location {
  id          String     @id @default(cuid())
  name        String     @unique
  address     String
  phone       String?
  timezone    String     @default("America/Los_Angeles")
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  shortName   String?
  city        String?
  state       String?
  zipCode     String?
  email       String?
  fax         String?
  taxId       String?
  npiNumber   String?
  openingTime DateTime?  @db.Time(6)
  closingTime DateTime?  @db.Time(6)
  workingDays String[]   @default(["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"])
  customers   Customer[]
  employees   Employee[]

  @@map("locations")
}

model LensProduct {
  id                            String   @id(map: "products_pkey") @default(cuid())
  name                          String
  sku                           String?  @unique(map: "products_sku_key")
  manufacturer                  String?
  basePrice                     Float
  tierVsp                       String?
  tierEyemed                    String?
  tierSpectera                  String?
  active                        Boolean  @default(true)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt
  displayGroup                  String   @default("reserve") @map("displayGroup")
  displayOrder                  Int      @default(100)
  category                      String
  rim_type_required             Boolean? @default(false)
  normalized_rim_type           String?
  pricing_method                String?  @default("by_tier")
  eyemed_discount_default       Decimal? @db.Decimal(3, 2)
  vsp_required_stack            String?
  spectera_plan_lookup_required Boolean? @default(false)
  enforcement_notes             String?

  @@map("lens_products")
}

model Customer {
  id                    String                   @id @default(cuid())
  firstName             String
  lastName              String
  email                 String?
  phone                 String?
  dateOfBirth           DateTime?
  gender                Gender?
  address               String?
  city                  String?
  state                 String?
  zipCode               String?
  insuranceCarrier      String?
  memberId              String?
  groupNumber           String?
  eligibilityDate       DateTime?
  active                Boolean                  @default(true)
  customerNumber        String?                  @unique
  accountStatus         AccountStatus            @default(ACTIVE)
  registrationDate      DateTime                 @default(now())
  lastVisit             DateTime?
  totalSpent            Float                    @default(0)
  averageOrderValue     Float                    @default(0)
  customerLifetimeValue Float                    @default(0)
  lastPurchaseDate      DateTime?
  isHighValueCustomer   Boolean                  @default(false)
  isFrequentCustomer    Boolean                  @default(false)
  riskLevel             RiskLevel                @default(LOW)
  marketingConsent      Boolean                  @default(false)
  notes                 String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  createdBy             String?
  updatedBy             String?
  primaryLocationId     String?
  primaryLocation       Location?                @relation(fields: [primaryLocationId], references: [id])
  authorizations        InsuranceAuthorization[]
  insuranceDocuments    InsuranceDocument[]
  priceLists            PatientPriceList[]
  quotes                Quote[]

  @@map("customers")
}

model Quote {
  id                   String      @id @default(cuid())
  customerId           String
  authorizationId      String?
  status               QuoteStatus @default(DRAFT)
  quoteNumber          String      @unique @default(cuid())
  retailTotal          Float
  insuranceTotal       Float       @default(0)
  patientTotal         Float
  tax                  Float       @default(0)
  grandTotal           Float
  items                Json
  examItems            Json?
  secondPair           Json?
  contactLenses        Json?
  materialsBenefitUsed String?
  notes                String?
  expiresAt            DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  createdBy            String?
  customer             Customer    @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([status])
  @@index([quoteNumber])
  @@map("quotes")
}

model InsuranceDocument {
  id              String                  @id @default(dbgenerated("(gen_random_uuid())::text"))
  customerId      String?                 @map("customer_id")
  authorizationId String?                 @map("authorization_id")
  fileName        String                  @map("file_name")
  filePath        String                  @map("file_path")
  fileType        String                  @map("file_type")
  fileSize        Int?                    @default(0) @map("file_size")
  ocrStatus       String?                 @default("pending") @map("ocr_status")
  gptStatus       String?                 @default("pending") @map("gpt_status")
  ocrError        String?                 @map("ocr_error")
  gptError        String?                 @map("gpt_error")
  carrier         String?
  planName        String?                 @map("plan_name")
  memberId        String?                 @map("member_id")
  extractedData   Json?                   @map("extracted_data")
  confidenceScore Decimal?                @map("confidence_score") @db.Decimal(3, 2)
  rawOcrText      String?                 @map("raw_ocr_text")
  isVerified      Boolean?                @default(false) @map("is_verified")
  verifiedBy      String?                 @map("verified_by")
  verifiedAt      DateTime?               @map("verified_at") @db.Timestamp(6)
  uploadedBy      String?                 @map("uploaded_by")
  createdAt       DateTime?               @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime?               @default(now()) @map("updated_at") @db.Timestamp(6)
  authorization   InsuranceAuthorization? @relation(fields: [authorizationId], references: [id], onUpdate: NoAction)
  customer        Customer?               @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([customerId], map: "idx_doc_customer")
  @@index([ocrStatus, gptStatus], map: "idx_doc_status")
  @@map("insurance_documents")
}

model Frame {
  id              String       @id @default(cuid())
  manufacturer    String
  brand           String
  collection      String?
  model           String
  color           String
  colorCode       String?
  eyeSize         Int?
  bridge          Int?
  temple          Int?
  upc             String?
  sku             String?      @unique
  internalId      String?
  wholesaleCost   Float
  retailPrice     Float
  stockQuantity   Int          @default(0)
  gender          FrameGender?
  pricingCategory String?
  description     String?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  showInPos       Boolean      @default(true)
  isFeatured      Boolean      @default(false)
  posDisplayOrder Int          @default(999)

  @@index([manufacturer])
  @@index([brand])
  @@index([model])
  @@index([brand, model])
  @@index([pricingCategory])
  @@index([showInPos, isFeatured, posDisplayOrder])
  @@map("frames")
}

model ContactLens {
  id                   String   @id @default(cuid())
  manufacturer         String
  lensName             String
  boxSize              Int
  wholesaleCost        Float?
  retailPrice          Float
  annualSupplyBothEyes Int?
  annualSupplyPerEye   Int?
  isAstigmatism        Boolean  @default(false)
  isMultifocal         Boolean  @default(false)
  isDaily              Boolean  @default(false)
  isWeekly             Boolean  @default(false)
  isMonthly            Boolean  @default(false)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  eyemedCategory       String?
  isColor              Boolean  @default(false)
  isExtendedWear       Boolean  @default(false)
  notes                String?
  officePrice          Float?
  specteraCategory     String?
  vspCategory          String?
  showInPos            Boolean  @default(true)
  isFeatured           Boolean  @default(false)
  posDisplayOrder      Int      @default(999)
  modality             String?
  pricingCategory      String?

  @@unique([manufacturer, lensName, boxSize])
  @@index([manufacturer])
  @@index([lensName])
  @@index([isActive])
  @@index([pricingCategory])
  @@index([showInPos, isFeatured, posDisplayOrder])
  @@map("contact_lenses")
}

model ServicePrice {
  id                 String           @id @default(cuid())
  name               String
  code               String?
  retailPrice        Float
  category           ServiceCategory?
  pricingCategory    String?
  description        String?
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  sku                String?          @unique
  billingBucket      String?
  eyemedAllowance    Float?
  isCoveredByMedical Boolean          @default(false)
  isCoveredByVision  Boolean          @default(false)
  notes              String?
  originalPrice      Float?
  specteraAllowance  Float?
  vspAllowance       Float?
  showInPos          Boolean          @default(true)
  isFeatured         Boolean          @default(false)
  posDisplayOrder    Int              @default(999)
  tierVsp            String?
  tierEyemed         String?
  tierSpectera       String?

  @@index([name])
  @@index([code])
  @@index([category])
  @@index([pricingCategory])
  @@index([billingBucket])
  @@index([showInPos, isFeatured, posDisplayOrder])
  @@index([tierVsp, tierEyemed, tierSpectera])
  @@map("service_prices")
}

model Employee {
  id                String         @id @default(cuid())
  externalId        String?        @unique
  firstName         String
  lastName          String
  username          String         @unique
  email             String?
  phone             String?
  address           String?
  primaryLocationId String?
  active            Boolean        @default(true)
  hireDate          DateTime?
  terminationDate   DateTime?
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  locationIds       String[]       @default([])
  roles             EmployeeRole[]
  primaryLocation   Location?      @relation(fields: [primaryLocationId], references: [id])

  @@map("employees")
}

model InsuranceAuthorization {
  id               String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  customerId       String    @map("customer_id")
  carrier          String
  planName         String?   @map("plan_name")
  memberId         String?   @map("member_id")
  memberName       String?   @map("member_name")
  examEligible     Boolean?  @default(false) @map("exam_eligible")
  lensesEligible   Boolean?  @default(false) @map("lenses_eligible")
  frameEligible    Boolean?  @default(false) @map("frame_eligible")
  contactsEligible Boolean?  @default(false) @map("contacts_eligible")
  frameAllowance            Decimal?  @map("frame_allowance") @db.Decimal(10, 2)
  contactAllowance          Decimal?  @map("contact_allowance") @db.Decimal(10, 2)
  isContactDecliningBalance Boolean?  @default(false) @map("is_contact_declining_balance")

  // Benefit structure: COPAY_ALLOWANCE (traditional) or DECLINING_BALANCE (unified pool)
  benefitStructure          String?   @default("COPAY_ALLOWANCE") @map("benefit_structure")
  // Unified declining balance fields (when benefitStructure = DECLINING_BALANCE)
  totalMaterialsAllowance   Decimal?  @map("total_materials_allowance") @db.Decimal(10, 2)
  decliningBalanceAppliesTo String[]  @default([]) @map("declining_balance_applies_to")  // ["frame", "lens", "lensOptions", "contacts"]
  overageDiscountFrame      Decimal?  @map("overage_discount_frame") @db.Decimal(5, 2)  // e.g., 20.00 for 20%
  overageDiscountContactConv Decimal? @map("overage_discount_contact_conv") @db.Decimal(5, 2)
  overageDiscountContactDisp Decimal? @map("overage_discount_contact_disp") @db.Decimal(5, 2)
  eitherOrRestriction       Boolean?  @default(false) @map("either_or_restriction")

  examCopay                 Decimal?  @map("exam_copay") @db.Decimal(10, 2)
  materialsCopay   Decimal?  @map("materials_copay") @db.Decimal(10, 2)
  copays           Json      @default("{}")
  rawExtractedData Json?     @map("raw_extracted_data")
  confidenceScore  Decimal?  @map("confidence_score") @db.Decimal(3, 2)
  isActive         Boolean?  @default(true) @map("is_active")
  usedForOrder     Boolean?  @default(false) @map("used_for_order")
  usedDate         DateTime? @map("used_date") @db.Timestamp(6)
  expirationDate   DateTime? @map("expiration_date") @db.Date
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)

  customer   Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  documents  InsuranceDocument[]
  priceLists PatientPriceList[]

  @@index([isActive], map: "idx_auth_active")
  @@index([carrier], map: "idx_auth_carrier")
  @@index([customerId], map: "idx_auth_customer")
  @@map("insurance_authorizations")
}

model PatientPriceList {
  id                  String                  @id(map: "customer_price_lists_pkey") @default(dbgenerated("(gen_random_uuid())::text"))
  customerId          String                  @map("customer_id")
  productId           String                  @map("product_id")
  authorizationId     String?                 @map("authorization_id")
  retailPrice         Decimal                 @map("retail_price") @db.Decimal(10, 2)
  finalPrice          Decimal?                @map("final_price") @db.Decimal(10, 2)
  savings             Decimal?                @default(0) @db.Decimal(10, 2)
  insuranceCarrier    String?                 @map("insurance_carrier")
  planName            String?                 @map("plan_name")
  tier                String?
  pricingMethod       String?                 @map("pricing_method")
  needsTierAssignment Boolean?                @default(false) @map("needs_tier_assignment")
  active              Boolean?                @default(true)
  createdAt           DateTime?               @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime?               @default(now()) @map("updated_at") @db.Timestamp(6)
  authorization       InsuranceAuthorization? @relation(fields: [authorizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "customer_price_lists_authorization_id_fkey")
  customer            Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "customer_price_lists_customer_id_fkey")

  @@unique([customerId, productId, insuranceCarrier], map: "customer_price_lists_customer_id_product_id_insurance_carri_key")
  @@index([active], map: "idx_price_active")
  @@index([customerId], map: "idx_price_customer")
  @@map("patient_price_lists")
}

