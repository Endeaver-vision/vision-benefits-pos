generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Location {
  id              String                    @id @default(cuid())
  name            String                    @unique
  address         String
  phone           String?
  timezone        String                    @default("America/Los_Angeles")
  active          Boolean                   @default(true)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  shortName       String?
  city            String?
  state           String?
  zipCode         String?
  email           String?
  fax             String?
  taxId           String?
  npiNumber       String?
  openingTime     DateTime?                 @db.Time
  closingTime     DateTime?                 @db.Time
  workingDays     String[]                  @default(["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"])
  customers       Customer[]
  employees       Employee[]
  frameInventory  FrameInventory[]
  inventory       Inventory[]
  productSettings LocationProductSettings[]
  products        ProductLocation[]
  purchaseOrders  PurchaseOrder[]
  transactions    Transaction[]

  @@map("locations")
}

model ProductCategory {
  id           String    @id @default(cuid())
  name         String    @unique
  code         String    @unique
  description  String?
  active       Boolean   @default(true)
  displayOrder Int       @default(100)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  products     Product[]

  @@index([displayOrder])
  @@map("product_categories")
}

model Product {
  id                 String              @id @default(cuid())
  name               String
  sku                String?             @unique
  categoryId         String
  manufacturer       String?
  basePrice          Float
  tierVsp            String?
  tierEyemed         String?
  tierSpectera       String?
  active             Boolean             @default(true)
  displayTier        String              @default("reserve") // 'everyday' or 'reserve'
  displayOrder       Int                 @default(100)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  inventory          Inventory[]
  locations          ProductLocation[]
  suppliers          ProductSupplier[]
  category           ProductCategory     @relation(fields: [categoryId], references: [id])
  purchaseOrderItems PurchaseOrderItem[]
  transactionItems   TransactionItem[]

  @@index([displayTier, categoryId, displayOrder])
  @@map("products")
}

model ProductLocation {
  id            String   @id @default(cuid())
  productId     String
  locationId    String
  priceOverride Float?
  available     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  location      Location @relation(fields: [locationId], references: [id])
  product       Product  @relation(fields: [productId], references: [id])

  @@unique([productId, locationId])
  @@map("product_locations")
}

model Customer {
  id                    String              @id @default(cuid())
  firstName             String
  lastName              String
  email                 String?
  phone                 String?
  dateOfBirth           DateTime?
  gender                Gender?
  address               String?
  city                  String?
  state                 String?
  zipCode               String?
  insuranceCarrier      String?
  memberId              String?
  groupNumber           String?
  eligibilityDate       DateTime?
  active                Boolean             @default(true)
  customerNumber        String?             @unique
  accountStatus         AccountStatus       @default(ACTIVE)
  registrationDate      DateTime            @default(now())
  lastVisit             DateTime?
  totalSpent            Float               @default(0)
  averageOrderValue     Float               @default(0)
  customerLifetimeValue Float               @default(0)
  lastPurchaseDate      DateTime?
  isHighValueCustomer   Boolean             @default(false)
  isFrequentCustomer    Boolean             @default(false)
  riskLevel             RiskLevel           @default(LOW)
  marketingConsent      Boolean             @default(false)
  notes                 String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  createdBy             String?
  updatedBy             String?
  primaryLocationId     String?
  primaryLocation       Location?           @relation(fields: [primaryLocationId], references: [id])
  prescriptions         EyePrescription[]
  insuranceCases        InsuranceCase[]
  insuranceDocuments    InsuranceDocument[]
  orders                Order[]             @relation("CustomerOrders")
  priceList             CustomerPriceList[]
  quotes                Quote[]
  transactions          Transaction[]

  @@map("customers")
}

model EyePrescription {
  id                String           @id @default(cuid())
  customerId        String
  prescriptionDate  DateTime
  providerId        String?
  providerName      String?
  rightEyeJson      String           @default("{}")
  leftEyeJson       String           @default("{}")
  pupillaryDistance Float?
  bifocalHeight     Float?
  prescriptionType  PrescriptionType
  notes             String?
  expirationDate    DateTime?
  isActive          Boolean          @default(true)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  customer          Customer         @relation(fields: [customerId], references: [id])

  @@map("eye_prescriptions")
}

model Quote {
  id                   String      @id @default(cuid())
  customerId           String
  authorizationId      String?
  status               QuoteStatus @default(DRAFT)
  quoteNumber          String      @unique @default(cuid())
  retailTotal          Float
  insuranceTotal       Float       @default(0)
  patientTotal         Float
  tax                  Float       @default(0)
  grandTotal           Float
  items                Json
  examItems            Json?
  secondPair           Json?
  contactLenses        Json?
  notes                String?
  expiresAt            DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  createdBy            String?
  materialsBenefitUsed String?
  customer             Customer    @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([status])
  @@index([quoteNumber])
  @@map("quotes")
}

model Transaction {
  id                String            @id @default(cuid())
  customerId        String
  userId            String
  locationId        String
  subtotal          Float
  tax               Float
  discount          Float             @default(0)
  total             Float
  insuranceCarrier  String?
  insuranceDiscount Float             @default(0)
  patientPortion    Float
  status            TransactionStatus @default(PENDING)
  paymentMethod     String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  items             TransactionItem[]
  customer          Customer          @relation(fields: [customerId], references: [id])
  location          Location          @relation(fields: [locationId], references: [id])
  employee          Employee          @relation(fields: [userId], references: [id])

  @@map("transactions")
}

model TransactionItem {
  id                String      @id @default(cuid())
  transactionId     String
  productId         String
  quantity          Int         @default(1)
  unitPrice         Float
  discount          Float       @default(0)
  total             Float
  insuranceTier     String?
  insuranceDiscount Float       @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  product           Product     @relation(fields: [productId], references: [id])
  transaction       Transaction @relation(fields: [transactionId], references: [id])

  @@map("transaction_items")
}

model Inventory {
  id              String              @id @default(cuid())
  productId       String
  locationId      String
  currentStock    Int                 @default(0)
  reservedStock   Int                 @default(0)
  availableStock  Int                 @default(0)
  reorderPoint    Int                 @default(5)
  reorderQuantity Int                 @default(20)
  maxStock        Int?
  costPrice       Float?
  lastCostPrice   Float?
  lastRestocked   DateTime?
  lastSold        DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  location        Location            @relation(fields: [locationId], references: [id])
  product         Product             @relation(fields: [productId], references: [id])
  movements       InventoryMovement[]

  @@unique([productId, locationId])
  @@map("inventory")
}

model InventoryMovement {
  id            String       @id @default(cuid())
  inventoryId   String
  type          MovementType
  quantity      Int
  reason        String?
  referenceType String?
  referenceId   String?
  unitCost      Float?
  userId        String?
  notes         String?
  createdAt     DateTime     @default(now())
  inventory     Inventory    @relation(fields: [inventoryId], references: [id])
  employee      Employee?    @relation(fields: [userId], references: [id])

  @@map("inventory_movements")
}

model Supplier {
  id             String            @id @default(cuid())
  name           String            @unique
  contactName    String?
  email          String?
  phone          String?
  address        String?
  city           String?
  state          String?
  zipCode        String?
  country        String            @default("USA")
  website        String?
  taxId          String?
  paymentTerms   String?
  active         Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  products       ProductSupplier[]
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model ProductSupplier {
  id            String   @id @default(cuid())
  productId     String
  supplierId    String
  supplierSku   String?
  supplierPrice Float?
  leadTimeDays  Int?
  minimumOrder  Int      @default(1)
  isPrimary     Boolean  @default(false)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  product       Product  @relation(fields: [productId], references: [id])
  supplier      Supplier @relation(fields: [supplierId], references: [id])

  @@unique([productId, supplierId])
  @@map("product_suppliers")
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  supplierId   String
  locationId   String
  userId       String
  orderNumber  String              @unique
  status       PurchaseOrderStatus @default(PENDING)
  subtotal     Float
  tax          Float               @default(0)
  shipping     Float               @default(0)
  total        Float
  orderDate    DateTime            @default(now())
  expectedDate DateTime?
  receivedDate DateTime?
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  items        PurchaseOrderItem[]
  location     Location            @relation(fields: [locationId], references: [id])
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  employee     Employee            @relation(fields: [userId], references: [id])

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String        @id @default(cuid())
  purchaseOrderId  String
  productId        String
  quantityOrdered  Int
  quantityReceived Int           @default(0)
  unitCost         Float
  total            Float
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  product          Product       @relation(fields: [productId], references: [id])
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  @@map("purchase_order_items")
}

model InsuranceCase {
  id             String              @id @default(cuid())
  customerId     String?
  mergedData     Json?
  mergedAt       DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  externalCaseId String?             @unique
  customer       Customer?           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  documents      InsuranceDocument[]

  @@index([customerId])
  @@map("insurance_cases")
}

model InsuranceDocument {
  id                String         @id @default(cuid())
  customerId        String?
  caseId            String?
  documentType      DocumentType   @default(INSURANCE_CARD_FRONT)
  fileName          String
  fileType          String
  filePath          String
  fileSize          Int
  uploadedBy        String
  rawOcrText        String?
  ocrProcessedAt    DateTime?
  ocrStatus         String         @default("pending")
  ocrError          String?
  carrier           String?
  planName          String?
  memberId          String?
  groupNumber       String?
  copayExam         Decimal?       @db.Decimal(10, 2)
  copayMaterials    Decimal?       @db.Decimal(10, 2)
  frameAllowance    Decimal?       @db.Decimal(10, 2)
  lensAllowance     Decimal?       @db.Decimal(10, 2)
  contactAllowance  Decimal?       @db.Decimal(10, 2)
  networkTier       String?
  effectiveDate     DateTime?
  expirationDate    DateTime?
  gptProcessedAt    DateTime?
  gptStatus         String         @default("pending")
  gptError          String?
  confidenceScore   Float?
  extractedData     Json?
  verifiedBy        String?
  verifiedAt        DateTime?
  isVerified        Boolean        @default(false)
  verificationNotes String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  case              InsuranceCase? @relation(fields: [caseId], references: [id])
  customer          Customer?      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([caseId])
  @@index([carrier])
  @@index([isVerified])
  @@index([ocrStatus])
  @@index([gptStatus])
  @@index([createdAt])
  @@map("insurance_documents")
}

model LensProduct {
  id              String            @id @default(cuid())
  name            String
  category        LensCategory
  wholesaleCost   Float?
  multiplier      Float             @default(3.0)
  retailPrice     Float
  manufacturer    String?
  sku             String?           @unique
  description     String?
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  showInPos       Boolean           @default(true)
  isFeatured      Boolean           @default(false)
  posDisplayOrder Int               @default(999)
  isPreferred     Boolean           @default(false)
  pricingCategory String?
  carrierTiers    LensCarrierTier[]

  @@index([category])
  @@index([pricingCategory])
  @@index([name])
  @@index([showInPos, isFeatured, posDisplayOrder])
  @@map("lens_products")
}

model LensCarrierTier {
  id            String      @id @default(cuid())
  lensProductId String
  carrier       String
  tierCode      String
  tierLabel     String?
  patientCopay  Float?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  lensProduct   LensProduct @relation(fields: [lensProductId], references: [id], onDelete: Cascade)

  @@unique([lensProductId, carrier])
  @@index([carrier, tierCode])
  @@map("lens_carrier_tiers")
}

model Frame {
  id              String           @id @default(cuid())
  manufacturer    String
  brand           String
  collection      String?
  model           String
  color           String
  colorCode       String?
  eyeSize         Int?
  bridge          Int?
  temple          Int?
  upc             String?
  sku             String?          @unique
  internalId      String?
  wholesaleCost   Float
  retailPrice     Float
  stockQuantity   Int              @default(0)
  gender          FrameGender?
  description     String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  showInPos       Boolean          @default(true)
  isFeatured      Boolean          @default(false)
  posDisplayOrder Int              @default(999)
  pricingCategory String?
  inventory       FrameInventory[]

  @@index([manufacturer])
  @@index([brand])
  @@index([model])
  @@index([brand, model])
  @@index([pricingCategory])
  @@index([showInPos, isFeatured, posDisplayOrder])
  @@map("frames")
}

model FrameInventory {
  id          String   @id @default(cuid())
  frameId     String
  locationId  String
  quantity    Int      @default(0)
  lastUpdated DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  frame       Frame    @relation(fields: [frameId], references: [id], onDelete: Cascade)
  location    Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([frameId, locationId])
  @@index([locationId])
  @@index([frameId])
  @@map("frame_inventory")
}

model ContactLens {
  id                   String   @id @default(cuid())
  manufacturer         String
  lensName             String
  boxSize              Int
  wholesaleCost        Float?
  retailPrice          Float
  annualSupplyBothEyes Int?
  annualSupplyPerEye   Int?
  isAstigmatism        Boolean  @default(false)
  isMultifocal         Boolean  @default(false)
  isDaily              Boolean  @default(false)
  isWeekly             Boolean  @default(false)
  isMonthly            Boolean  @default(false)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  eyemedCategory       String?
  isColor              Boolean  @default(false)
  isExtendedWear       Boolean  @default(false)
  notes                String?
  officePrice          Float?
  specteraCategory     String?
  vspCategory          String?
  showInPos            Boolean  @default(true)
  isFeatured           Boolean  @default(false)
  posDisplayOrder      Int      @default(999)
  modality             String?
  pricingCategory      String?

  @@unique([manufacturer, lensName, boxSize])
  @@index([manufacturer])
  @@index([lensName])
  @@index([isActive])
  @@index([pricingCategory])
  @@index([showInPos, isFeatured, posDisplayOrder])
  @@map("contact_lenses")
}

model ServicePrice {
  id                 String           @id @default(cuid())
  name               String
  code               String?
  retailPrice        Float
  category           ServiceCategory?
  description        String?
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  sku                String?          @unique
  billingBucket      String?
  eyemedAllowance    Float?
  isCoveredByMedical Boolean          @default(false)
  isCoveredByVision  Boolean          @default(false)
  notes              String?
  originalPrice      Float?
  specteraAllowance  Float?
  vspAllowance       Float?
  showInPos          Boolean          @default(true)
  isFeatured         Boolean          @default(false)
  posDisplayOrder    Int              @default(999)
  pricingCategory    String?

  @@index([name])
  @@index([code])
  @@index([category])
  @@index([pricingCategory])
  @@index([billingBucket])
  @@index([showInPos, isFeatured, posDisplayOrder])
  @@map("service_prices")
}

model VspAuthorization {
  id                      String                    @id @default(cuid())
  customerId              String
  authorizationNumber     String                    @unique
  planName                String
  planType                VspPlanType
  examCopay               Float?
  materialsCopay          Float?
  frameAllowanceRetail    Float?
  frameAllowanceMarchon   Float?
  frameOverageDiscount    Float?
  contactAllowance        Float?
  contactFittingCovered   Boolean                   @default(false)
  contactLensExamCopay    Float? // Numeric value from "lesser of $60 copay..."
  contactFittingRule      String? // Full rule text for reference
  authDate                DateTime                  @default(now())
  expirationDate          DateTime?
  serviceYear             Int?
  isActive                Boolean                   @default(true)
  usedForOrder            Boolean                   @default(false)
  usedDate                DateTime?
  rawPatientReport        Json?
  rawLensEnhancements     Json?
  // Declining balance support
  benefitStructure        String? // 'COPAY_ALLOWANCE', 'DECLINING_BALANCE'
  totalMaterialsCredit    Float?
  creditAppliesToFrames   Boolean                   @default(true)
  creditAppliesToLenses   Boolean                   @default(true)
  creditAppliesToCoatings Boolean                   @default(true)
  creditAppliesToContacts Boolean                   @default(false)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  lensEnhancementCopays   VspLensEnhancementCopay[]

  @@index([customerId])
  @@index([authorizationNumber])
  @@index([isActive])
  @@map("vsp_authorizations")
}

model EyemedAuthorization {
  id                         String                 @id @default(cuid())
  customerId                 String
  memberId                   String
  memberName                 String
  dateOfBirth                DateTime?
  network                    String?
  groupName                  String?
  groupNumber                String?
  benefitLevel               String?
  examEligible               Boolean                @default(false)
  lensesEligible             Boolean                @default(false)
  frameEligible              Boolean                @default(false)
  contactsEligible           Boolean                @default(false)
  clFitEligible              Boolean                @default(false)
  examEligibleDate           DateTime?
  lensesEligibleDate         DateTime?
  frameEligibleDate          DateTime?
  contactsEligibleDate       DateTime?
  examFrequency              String?
  lensesFrequency            String?
  frameFrequency             String?
  contactsFrequency          String?
  examCopay                  Float?
  retinalImagingMax          Float?
  clFitStandardCopay         String?
  clFitPremiumCopay          String?
  frameAllowance             Float?
  frameOverageDiscount       Float?
  frameCopay                 Float?
  singleVisionCopay          Float?
  bifocalCopay               Float?
  trifocalCopay              Float?
  lenticularCopay            String?
  progressiveStandardCopay   Float?
  progressiveTier1Copay      Float?
  progressiveTier2Copay      Float?
  progressiveTier3Copay      Float?
  contactAllowance           Float?
  contactConventionalOverage String?
  contactDisposableOverage   String?
  contactMedicallyNecessary  String?
  additionalGlassesAllowance Float?
  additionalGlassesDiscount  String?
  dateOfService              DateTime               @default(now())
  expirationDate             DateTime?
  isActive                   Boolean                @default(true)
  usedForOrder               Boolean                @default(false)
  usedDate                   DateTime?
  rawBenefitsData            Json?
  createdAt                  DateTime               @default(now())
  updatedAt                  DateTime               @updatedAt
  blueLightFilterCopay       Float?
  highIndex160Copay          Float?
  highIndex167Copay          Float?
  highIndex174Copay          Float?
  mirrorCoatingCopay         Float?
  photochromicCopay          Float?
  polarizedCopay             Float?
  polycarbonateAdultCopay    Float?
  polycarbonateChildCopay    Float?
  progressiveTier4CopayText  String?
  progressiveTier5Copay      Float?
  tintCopay                  Float?
  trivexCopay                Float?
  progressiveTier4Copay      Float?
  benefitStructure           String?
  creditAppliesToCoatings    Boolean                @default(true)
  creditAppliesToContacts    Boolean                @default(false)
  creditAppliesToFrames      Boolean                @default(true)
  creditAppliesToLenses      Boolean                @default(true)
  overageDiscountPercent     Float?
  totalMaterialsCredit       Float?
  arCoatingCopays            EyemedArCoatingCopay[]

  @@index([customerId])
  @@index([memberId])
  @@index([isActive])
  @@map("eyemed_authorizations")
}

model SpecteraAuthorization {
  id                           String                   @id @default(cuid())
  customerId                   String
  subscriberId                 String
  memberName                   String
  dateOfBirth                  DateTime?
  productName                  String?
  examEligible                 Boolean                  @default(false)
  examFrequency                String?
  maternityExamEligible        Boolean                  @default(false)
  maternityExamFrequency       String?
  pediatricExamEligible        Boolean                  @default(false)
  pediatricExamFrequency       String?
  frameEligible                Boolean                  @default(false)
  frameFrequency               String?
  lensesEligible               Boolean                  @default(false)
  lensesFrequency              String?
  selectionClDailyEligible     Boolean                  @default(false)
  selectionClMonthlyEligible   Boolean                  @default(false)
  nonSelectionClEligible       Boolean                  @default(false)
  selectionClFitEligible       Boolean                  @default(false)
  nonSelectionClFitEligible    Boolean                  @default(false)
  examCopay                    Float?
  maternityExamCopay           Float?
  pediatricExamCopay           Float?
  selectionClFitCopay          String?
  nonSelectionClFitCopay       String?
  frameAllowance               Float?
  frameOveragePercent          Float?
  standardLensCopay            Float?
  progressiveTier1Copay        Float?
  progressiveTier2Copay        Float?
  progressiveTier3Copay        Float?
  progressiveTier4Copay        Float?
  progressiveTier5Copay        Float?
  progressiveNonFormularyCopay String?
  blendedBifocalsCopay         String?
  freeformSvCopay              String?
  svAsphericCopay              String?
  mfAsphericCopay              String?
  polycarbonate                String?
  highIndex166                 Float?
  highIndex167to173            Float?
  highIndex174Plus             String?
  selectionClDailyCopay        String?
  selectionClMonthlyCopay      String?
  nonSelectionClAllowance      Float?
  nonSelectionClOverage        Float?
  necessaryClCopay             Float?
  dateOfService                DateTime                 @default(now())
  expirationDate               DateTime?
  dilatedRetinalExamRequired   Boolean                  @default(false)
  isActive                     Boolean                  @default(true)
  usedForOrder                 Boolean                  @default(false)
  usedDate                     DateTime?
  rawBenefitsData              Json?
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt
  blueLightFilterCopay         Float?
  highIndex174Copay            Float?
  mirrorCoatingCopay           Float?
  photochromicCopay            Float?
  polarizedCopay               Float?
  polycarbonateAdultCopay      Float?
  polycarbonateChildCopay      Float?
  tintCopay                    Float?
  trivexCopay                  Float?
  // Declining balance support
  benefitStructure             String? // 'COPAY_ALLOWANCE', 'DECLINING_BALANCE'
  totalMaterialsCredit         Float?
  creditAppliesToFrames        Boolean                  @default(true)
  creditAppliesToLenses        Boolean                  @default(true)
  creditAppliesToCoatings      Boolean                  @default(true)
  creditAppliesToContacts      Boolean                  @default(false)
  arCoatingCopays              SpecteraArCoatingCopay[]

  @@index([customerId])
  @@index([subscriberId])
  @@index([isActive])
  @@map("spectera_authorizations")
}

// ============================================
// INSURANCE COPAY JUNCTION TABLES
// ============================================

model CustomerPriceList {
  id                    String    @id @default(cuid())
  customerId            String
  productId             String
  authorizationId       String?   // Link to specific authorization
  authorizationType     String?   // 'vsp', 'eyemed', 'spectera'
  finalPrice            Float?    // Customer pays this (copay or 80% retail fallback)
  retailPrice           Float
  savings               Float     @default(0)
  insuranceCarrier      String?
  planName              String?
  tier                  String?   // "K-1", "tier_1", "I", etc.
  needsTierAssignment   Boolean   @default(false) // True if using fallback pricing (80% retail)
  validFrom             DateTime?
  validUntil            DateTime?
  customPrice           Float?    // Manual override
  priceOverrideReason   String?
  priceOverrideBy       String?
  priceOverrideDate     DateTime?
  active                Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  customer              Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // Support multiple carriers per customer - one price per product per carrier
  @@unique([customerId, productId, insuranceCarrier])
  @@index([customerId])
  @@index([productId])
  @@index([authorizationId])
  @@map("customer_price_lists")
}

model VspLensEnhancementCopay {
  id                String           @id @default(cuid())
  authorizationId   String
  code              String // KA, FA, QT, AD, PR, SW, etc.
  description       String
  copaySingleVision Float?
  copayMultifocal   Float?
  isAddonCode       Boolean          @default(false)
  baseCode          String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  authorization     VspAuthorization @relation(fields: [authorizationId], references: [id], onDelete: Cascade)

  @@unique([authorizationId, code])
  @@index([authorizationId])
  @@map("vsp_lens_enhancement_copays")
}

model EyemedArCoatingCopay {
  id              String              @id @default(cuid())
  authorizationId String
  tier            String // 'standard', 'tier_1', 'tier_2', 'tier_3'
  copay           String // Stored as string for flexibility
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  authorization   EyemedAuthorization @relation(fields: [authorizationId], references: [id], onDelete: Cascade)

  @@unique([authorizationId, tier])
  @@index([authorizationId])
  @@map("eyemed_ar_coating_copays")
}

model SpecteraArCoatingCopay {
  id              String                @id @default(cuid())
  authorizationId String
  tier            String // 'tier_1', 'tier_2', 'tier_3', 'tier_4'
  copay           String
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  authorization   SpecteraAuthorization @relation(fields: [authorizationId], references: [id], onDelete: Cascade)

  @@unique([authorizationId, tier])
  @@index([authorizationId])
  @@map("spectera_ar_coating_copays")
}

model LocationProductSettings {
  id              String      @id @default(cuid())
  locationId      String
  productType     ProductType
  productId       String
  showInPos       Boolean     @default(true)
  isFeatured      Boolean     @default(false)
  posDisplayOrder Int         @default(999)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  location        Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, productType, productId])
  @@index([locationId, productType])
  @@index([productId, productType])
  @@map("location_product_settings")
}

model Order {
  id                      String               @id @default(cuid())
  orderNumber             String               @unique
  customerId              String
  prescriptionId          String?
  status                  OrderStatus          @default(DRAFT)
  statusUpdatedAt         DateTime             @default(now())
  statusUpdatedBy         String?
  orderDate               DateTime             @default(now())
  estimatedCompletionDate DateTime
  actualCompletionDate    DateTime?
  labId                   String?
  labName                 String?
  labOrderNumber          String?
  labTrackingNumber       String?
  labEstimatedDelivery    DateTime?
  deliveryMethod          DeliveryMethod       @default(PICKUP)
  deliveryAddress         Json?
  deliveryInstructions    String?
  subtotal                Decimal              @db.Decimal(10, 2)
  taxAmount               Decimal              @db.Decimal(10, 2)
  discountAmount          Decimal?             @db.Decimal(10, 2)
  insuranceAmount         Decimal?             @db.Decimal(10, 2)
  shippingAmount          Decimal?             @db.Decimal(10, 2)
  totalAmount             Decimal              @db.Decimal(10, 2)
  amountPaid              Decimal              @default(0) @db.Decimal(10, 2)
  notes                   String?
  internalNotes           String?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  createdBy               String
  isOverdue               Boolean              @default(false)
  overdueReason           String?
  patientDeliveryDate     DateTime?
  shipmentEnd             DateTime?
  shipmentStart           DateTime?
  vendorPlacementDeadline DateTime?
  vendorProcessingEnd     DateTime?
  vendorProcessingStart   DateTime?
  alerts                  OrderAlert[]         @relation("OrderAlerts")
  communications          OrderCommunication[]
  items                   OrderItem[]
  qualityChecks           OrderQualityCheck[]
  statusHistory           OrderStatusHistory[]
  customer                Customer             @relation("CustomerOrders", fields: [customerId], references: [id])

  @@index([customerId])
  @@index([status])
  @@index([orderDate])
  @@index([orderNumber])
  @@map("orders")
}

model OrderItem {
  id                String          @id @default(cuid())
  orderId           String
  type              OrderItemType
  productId         String?
  productName       String
  sku               String
  description       String?
  lensType          String?
  lensCoatings      String[]
  prescriptionId    String?
  frameColor        String?
  frameSize         String?
  unitPrice         Decimal         @db.Decimal(10, 2)
  discountAmount    Decimal?        @db.Decimal(10, 2)
  insuranceCoverage Decimal?        @db.Decimal(10, 2)
  finalPrice        Decimal         @db.Decimal(10, 2)
  quantity          Int             @default(1)
  status            OrderItemStatus @default(PENDING)
  estimatedDelivery DateTime?
  actualDelivery    DateTime?
  labId             String?
  labOrderNumber    String?
  trackingNumber    String?
  customizations    Json?
  isCustom          Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@index([productId])
  @@map("order_items")
}

model OrderStatusHistory {
  id             String       @id @default(cuid())
  orderId        String
  status         OrderStatus
  previousStatus OrderStatus?
  updatedBy      String
  updatedByName  String?
  notes          String?
  timestamp      DateTime     @default(now())
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([timestamp])
  @@map("order_status_history")
}

model OrderCommunication {
  id         String                 @id @default(cuid())
  orderId    String
  type       CommunicationType
  direction  CommunicationDirection
  subject    String?
  message    String
  sentBy     String?
  sentByName String?
  sentTo     String?
  sentToName String?
  timestamp  DateTime               @default(now())
  metadata   Json?
  order      Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([timestamp])
  @@index([type])
  @@map("order_communications")
}

model OrderQualityCheck {
  id              String   @id @default(cuid())
  orderId         String
  performedBy     String
  performedByName String?
  performedAt     DateTime @default(now())
  passed          Boolean
  notes           String?
  issues          String[]
  checklist       Json?
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([performedAt])
  @@map("order_quality_checks")
}

model OrderStageConfig {
  id                     String      @id @default(cuid())
  stage                  OrderStatus @unique
  expectedDurationHours  Int
  warningThresholdHours  Int
  criticalThresholdHours Int
  autoNotify             Boolean     @default(true)
  notifyRoles            String[]
  active                 Boolean     @default(true)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  @@map("order_stage_configs")
}

model OrderAlert {
  id              String         @id @default(cuid())
  orderId         String
  orderNumber     String
  stage           OrderStatus
  alertType       OrderAlertType
  severity        AlertSeverity
  message         String
  notifiedAt      DateTime?
  acknowledgedAt  DateTime?
  acknowledgedBy  String?
  resolved        Boolean        @default(false)
  resolvedAt      DateTime?
  resolvedBy      String?
  resolutionNotes String?
  createdAt       DateTime       @default(now())
  order           Order          @relation("OrderAlerts", fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([stage])
  @@index([severity])
  @@index([resolved])
  @@index([createdAt])
  @@map("order_alerts")
}

// Employee model with locationIds array (replaces employee_locations junction table)
model Employee {
  id                 String              @id @default(cuid())
  externalId         String?             @unique
  firstName          String
  lastName           String
  username           String              @unique
  email              String?
  phone              String?
  address            String?
  roles              EmployeeRole[]
  primaryLocationId  String?
  locationIds        String[]            @default([])
  active             Boolean             @default(true)
  hireDate           DateTime?
  terminationDate    DateTime?
  notes              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  inventoryMovements InventoryMovement[]
  purchaseOrders     PurchaseOrder[]
  transactions       Transaction[]
  primaryLocation    Location?           @relation(fields: [primaryLocationId], references: [id])

  @@map("employees")
}

