generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Location {
  id          String     @id @default(cuid())
  name        String     @unique
  address     String
  phone       String?
  timezone    String     @default("America/Los_Angeles")
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  shortName   String?
  city        String?
  state       String?
  zipCode     String?
  email       String?
  fax         String?
  taxId       String?
  npiNumber   String?
  openingTime DateTime?  @db.Time(6)
  closingTime DateTime?  @db.Time(6)
  workingDays String[]   @default(["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"])
  customers   Customer[]
  employees   Employee[]

  @@map("locations")
}

model LensProduct {
  id                            String   @id(map: "products_pkey") @default(cuid())
  name                          String
  sku                           String?  @unique(map: "products_sku_key")
  manufacturer                  String?
  basePrice                     Float
  tierVsp                       String?
  tierEyemed                    String?
  tierSpectera                  String?
  active                        Boolean  @default(true)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt
  displayGroup                  String   @default("reserve") @map("displayGroup")
  displayOrder                  Int      @default(100)
  category                      String
  rim_type_required             Boolean? @default(false)
  normalized_rim_type           String?
  pricing_method                String?  @default("by_tier")
  eyemed_discount_default       Decimal? @db.Decimal(3, 2)
  vsp_required_stack            String?
  spectera_plan_lookup_required Boolean? @default(false)
  enforcement_notes             String?

  @@map("lens_products")
}

model Customer {
  id                    String                   @id @default(cuid())
  firstName             String
  lastName              String
  email                 String?
  phone                 String?
  dateOfBirth           DateTime?
  gender                Gender?
  address               String?
  city                  String?
  state                 String?
  zipCode               String?
  insuranceCarrier      String?
  memberId              String?
  groupNumber           String?
  eligibilityDate       DateTime?
  active                Boolean                  @default(true)
  customerNumber        String?                  @unique
  accountStatus         AccountStatus            @default(ACTIVE)
  registrationDate      DateTime                 @default(now())
  lastVisit             DateTime?
  totalSpent            Float                    @default(0)
  averageOrderValue     Float                    @default(0)
  customerLifetimeValue Float                    @default(0)
  lastPurchaseDate      DateTime?
  isHighValueCustomer   Boolean                  @default(false)
  isFrequentCustomer    Boolean                  @default(false)
  riskLevel             RiskLevel                @default(LOW)
  marketingConsent      Boolean                  @default(false)
  notes                 String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  createdBy             String?
  updatedBy             String?
  primaryLocationId     String?
  primaryLocation       Location?                @relation(fields: [primaryLocationId], references: [id])
  authorizations        InsuranceAuthorization[]
  insuranceDocuments    InsuranceDocument[]
  priceLists            PatientPriceList[]
  priceListVersions     PriceListVersion[]
  quotes                Quote[]
  priceListAudits       PriceListAudit[]

  @@map("customers")
}

model Quote {
  id                   String      @id @default(cuid())
  customerId           String
  authorizationId      String?
  status               QuoteStatus @default(DRAFT)
  quoteNumber          String      @unique @default(cuid())
  retailTotal          Float
  insuranceTotal       Float       @default(0)
  patientTotal         Float
  tax                  Float       @default(0)
  grandTotal           Float
  items                Json
  examItems            Json?
  secondPair           Json?
  contactLenses        Json?
  materialsBenefitUsed String?
  notes                String?
  expiresAt            DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  createdBy            String?
  customer             Customer    @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([status])
  @@index([quoteNumber])
  @@map("quotes")
}

model InsuranceDocument {
  id              String                  @id @default(dbgenerated("(gen_random_uuid())::text"))
  customerId      String?                 @map("customer_id")
  authorizationId String?                 @map("authorization_id")
  fileName        String                  @map("file_name")
  filePath        String                  @map("file_path")
  fileType        String                  @map("file_type")
  fileSize        Int?                    @default(0) @map("file_size")
  ocrStatus       String?                 @default("pending") @map("ocr_status")
  gptStatus       String?                 @default("pending") @map("gpt_status")
  ocrError        String?                 @map("ocr_error")
  gptError        String?                 @map("gpt_error")
  carrier         String?
  planName        String?                 @map("plan_name")
  memberId        String?                 @map("member_id")
  extractedData   Json?                   @map("extracted_data")
  confidenceScore Decimal?                @map("confidence_score") @db.Decimal(3, 2)
  rawOcrText      String?                 @map("raw_ocr_text")
  isVerified      Boolean?                @default(false) @map("is_verified")
  verifiedBy      String?                 @map("verified_by")
  verifiedAt      DateTime?               @map("verified_at") @db.Timestamp(6)
  uploadedBy      String?                 @map("uploaded_by")
  createdAt       DateTime?               @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt       DateTime?               @default(now()) @map("updated_at") @db.Timestamp(6)
  authorization   InsuranceAuthorization? @relation(fields: [authorizationId], references: [id], onUpdate: NoAction)
  customer        Customer?               @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([customerId], map: "idx_doc_customer")
  @@index([ocrStatus, gptStatus], map: "idx_doc_status")
  @@map("insurance_documents")
}

model Frame {
  id              String       @id @default(cuid())
  manufacturer    String
  brand           String
  collection      String?
  model           String
  color           String
  colorCode       String?
  eyeSize         Int?
  bridge          Int?
  temple          Int?
  upc             String?
  sku             String?      @unique
  internalId      String?
  wholesaleCost   Float
  retailPrice     Float
  stockQuantity   Int          @default(0)
  gender          FrameGender?
  pricingCategory String?
  description     String?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  showInPos       Boolean      @default(true)
  isFeatured      Boolean      @default(false)
  posDisplayOrder Int          @default(999)

  @@index([manufacturer])
  @@index([brand])
  @@index([model])
  @@index([brand, model])
  @@index([pricingCategory])
  @@index([showInPos, isFeatured, posDisplayOrder])
  @@map("frames")
}

model ContactLens {
  id                   String   @id @default(cuid())
  manufacturer         String
  lensName             String
  boxSize              Int
  wholesaleCost        Float?
  retailPrice          Float
  annualSupplyBothEyes Int?
  annualSupplyPerEye   Int?
  isAstigmatism        Boolean  @default(false)
  isMultifocal         Boolean  @default(false)
  isDaily              Boolean  @default(false)
  isWeekly             Boolean  @default(false)
  isMonthly            Boolean  @default(false)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  eyemedCategory       String?
  isColor              Boolean  @default(false)
  isExtendedWear       Boolean  @default(false)
  notes                String?
  officePrice          Float?
  specteraCategory     String?
  vspCategory          String?
  showInPos            Boolean  @default(true)
  isFeatured           Boolean  @default(false)
  posDisplayOrder      Int      @default(999)
  modality             String?
  pricingCategory      String?

  @@unique([manufacturer, lensName, boxSize])
  @@index([manufacturer])
  @@index([lensName])
  @@index([isActive])
  @@index([pricingCategory])
  @@index([showInPos, isFeatured, posDisplayOrder])
  @@map("contact_lenses")
}

model ServicePrice {
  id                 String           @id @default(cuid())
  name               String
  code               String?
  retailPrice        Float
  category           ServiceCategory?
  pricingCategory    String?
  description        String?
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  sku                String?          @unique
  billingBucket      String?
  eyemedAllowance    Float?
  isCoveredByMedical Boolean          @default(false)
  isCoveredByVision  Boolean          @default(false)
  notes              String?
  originalPrice      Float?
  specteraAllowance  Float?
  vspAllowance       Float?
  showInPos          Boolean          @default(true)
  isFeatured         Boolean          @default(false)
  posDisplayOrder    Int              @default(999)
  tierVsp            String?
  tierEyemed         String?
  tierSpectera       String?

  @@index([name])
  @@index([code])
  @@index([category])
  @@index([pricingCategory])
  @@index([billingBucket])
  @@index([showInPos, isFeatured, posDisplayOrder])
  @@index([tierVsp, tierEyemed, tierSpectera])
  @@map("service_prices")
}

model Employee {
  id                String         @id @default(cuid())
  externalId        String?        @unique
  firstName         String
  lastName          String
  username          String         @unique
  email             String?
  phone             String?
  address           String?
  primaryLocationId String?
  active            Boolean        @default(true)
  hireDate          DateTime?
  terminationDate   DateTime?
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  locationIds       String[]       @default([])
  roles             EmployeeRole[]
  primaryLocation   Location?      @relation(fields: [primaryLocationId], references: [id])

  @@map("employees")
}

model InsuranceAuthorization {
  id                        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  customerId                String   @map("customer_id")
  carrier                   String
  planName                  String?  @map("plan_name")
  memberId                  String?  @map("member_id")
  memberName                String?  @map("member_name")
  examEligible              Boolean? @default(false) @map("exam_eligible")
  lensesEligible            Boolean? @default(false) @map("lenses_eligible")
  frameEligible             Boolean? @default(false) @map("frame_eligible")
  contactsEligible          Boolean? @default(false) @map("contacts_eligible")
  frameAllowance            Decimal? @map("frame_allowance") @db.Decimal(10, 2)
  contactAllowance          Decimal? @map("contact_allowance") @db.Decimal(10, 2)
  isContactDecliningBalance Boolean? @default(false) @map("is_contact_declining_balance")

  // Benefit structure: COPAY_ALLOWANCE (traditional) or DECLINING_BALANCE (unified pool)
  benefitStructure           String?  @default("COPAY_ALLOWANCE") @map("benefit_structure")
  // Unified declining balance fields (when benefitStructure = DECLINING_BALANCE)
  totalMaterialsAllowance    Decimal? @map("total_materials_allowance") @db.Decimal(10, 2)
  decliningBalanceAppliesTo  String[] @default([]) @map("declining_balance_applies_to") // ["frame", "lens", "lensOptions", "contacts"]
  overageDiscountFrame       Decimal? @map("overage_discount_frame") @db.Decimal(5, 2) // e.g., 20.00 for 20%
  overageDiscountContactConv Decimal? @map("overage_discount_contact_conv") @db.Decimal(5, 2)
  overageDiscountContactDisp Decimal? @map("overage_discount_contact_disp") @db.Decimal(5, 2)
  eitherOrRestriction        Boolean? @default(false) @map("either_or_restriction")

  examCopay            Decimal? @map("exam_copay") @db.Decimal(10, 2)
  materialsCopay       Decimal? @map("materials_copay") @db.Decimal(10, 2)
  frameAllowanceAltair Decimal? @map("frame_allowance_altair") @db.Decimal(10, 2)
  clExamCopay          Decimal? @map("cl_exam_copay") @db.Decimal(10, 2)
  clFitStandard        Decimal? @map("cl_fit_standard") @db.Decimal(10, 2)
  clFitPremium         Decimal? @map("cl_fit_premium") @db.Decimal(10, 2)
  copays               Json     @default("{}")
  rawExtractedData     Json?    @map("raw_extracted_data")
  confidenceScore      Decimal? @map("confidence_score") @db.Decimal(3, 2)
  isActive             Boolean? @default(true) @map("is_active")

  // VSP two-document pairing fields
  // VSP requires two documents (auth + lens) that must be paired by Auth#
  vspAuthNumber   String?  @map("vsp_auth_number") @db.VarChar(20)
  vspDocumentType String?  @map("vsp_document_type") @db.VarChar(20) // 'vsp-auth', 'vsp-lens', 'vsp-combined', null
  vspPendingPair  Boolean? @default(false) @map("vsp_pending_pair")
  vspPairedAuthId String?  @map("vsp_paired_auth_id")

  usedForOrder   Boolean?  @default(false) @map("used_for_order")
  usedDate       DateTime? @map("used_date") @db.Timestamp(6)
  expirationDate DateTime? @map("expiration_date") @db.Date
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt      DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)

  customer          Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  documents         InsuranceDocument[]
  priceLists        PatientPriceList[]
  priceListVersions PriceListVersion[]
  priceListAudits   PriceListAudit[]

  @@index([isActive], map: "idx_auth_active")
  @@index([carrier], map: "idx_auth_carrier")
  @@index([customerId], map: "idx_auth_customer")
  @@map("insurance_authorizations")
}

model PatientPriceList {
  id                  String                  @id(map: "customer_price_lists_pkey") @default(dbgenerated("(gen_random_uuid())::text"))
  customerId          String                  @map("customer_id")
  productId           String                  @map("product_id")
  authorizationId     String?                 @map("authorization_id")
  retailPrice         Decimal                 @map("retail_price") @db.Decimal(10, 2)
  finalPrice          Decimal?                @map("final_price") @db.Decimal(10, 2)
  savings             Decimal?                @default(0) @db.Decimal(10, 2)
  insuranceCarrier    String?                 @map("insurance_carrier")
  planName            String?                 @map("plan_name")
  tier                String?
  pricingMethod       String?                 @map("pricing_method")
  needsTierAssignment Boolean?                @default(false) @map("needs_tier_assignment")
  active              Boolean?                @default(true)
  createdAt           DateTime?               @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt           DateTime?               @default(now()) @map("updated_at") @db.Timestamp(6)
  authorization       InsuranceAuthorization? @relation(fields: [authorizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "customer_price_lists_authorization_id_fkey")
  customer            Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "customer_price_lists_customer_id_fkey")

  // Link to version (for versioned price lists)
  versionId String?           @map("version_id")
  version   PriceListVersion? @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, productId], map: "patient_price_lists_version_product_key")
  @@index([active], map: "idx_price_active")
  @@index([customerId], map: "idx_price_customer")
  @@index([versionId], map: "idx_price_version")
  @@map("patient_price_lists")
}

// ============================================================================
// PRICE LIST VERSIONING
// Groups price list items into versioned sets for patient history
// ============================================================================

model PriceListVersion {
  id               String  @id @default(cuid())
  customerId       String  @map("customer_id")
  authorizationId  String? @map("authorization_id")
  insuranceCarrier String  @map("insurance_carrier")
  planName         String? @map("plan_name")

  // Versioning
  version      Int // Auto-increment per customer+carrier
  versionLabel String @map("version_label") // "v1 - 03/09/2026"

  // Full data storage (JSON)
  lensMatrixData Json? @map("lens_matrix_data") // VSP lens matrix
  extractedData  Json? @map("extracted_data") // Raw extraction result
  priceListData  Json? @map("price_list_data") // Complete calculated price list

  // Status
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  createdBy String?  @map("created_by")

  // Relations
  customer      Customer                @relation(fields: [customerId], references: [id], onDelete: Cascade)
  authorization InsuranceAuthorization? @relation(fields: [authorizationId], references: [id], onDelete: SetNull)
  priceItems    PatientPriceList[]

  @@unique([customerId, insuranceCarrier, version], map: "price_list_versions_customer_carrier_version_key")
  @@index([customerId, active], map: "idx_version_customer_active")
  @@index([insuranceCarrier], map: "idx_version_carrier")
  @@map("price_list_versions")
}

// ============================================================================
// VERIFICATION FRAMEWORK MODELS
// Track test runs, results, and expected values for insurance pricing validation
// ============================================================================

model VerificationRun {
  id             String               @id @default(cuid())
  runType        String               @map("run_type") // 'vsp-extraction', 'eyemed-extraction', 'price-verification', 'full-pipeline'
  carrier        String? // 'VSP', 'EyeMed', 'Spectera', or 'ALL'
  startedAt      DateTime             @default(now()) @map("started_at")
  completedAt    DateTime?            @map("completed_at")
  status         VerificationStatus   @default(RUNNING)
  totalDocuments Int                  @default(0) @map("total_documents")
  passed         Int                  @default(0)
  failed         Int                  @default(0)
  warnings       Int                  @default(0)
  runBy          String?              @map("run_by") // User ID or 'system'
  notes          String?
  results        VerificationResult[]

  @@map("verification_runs")
}

model VerificationResult {
  id              String  @id @default(cuid())
  runId           String  @map("run_id")
  customerId      String? @map("customer_id")
  documentId      String? @map("document_id")
  authorizationId String? @map("authorization_id")
  carrier         String
  customerName    String? @map("customer_name") // For display

  // Field being verified
  fieldName     String  @map("field_name") // 'examCopay', 'frameAllowance', 'NJ', 'progressiveTier3'
  fieldCategory String? @map("field_category") // 'copay', 'allowance', 'matrix', 'eligibility'

  // Values
  expectedValue  String? @map("expected_value") // From PDF/manual entry
  extractedValue String? @map("extracted_value") // From GPT extraction
  databaseValue  String? @map("database_value") // From DB after save
  generatedPrice String? @map("generated_price") // From price list (if applicable)

  // Status
  status          VerificationResultStatus
  mismatchType    String?                  @map("mismatch_type") // 'extraction_error', 'price_calculation_error', 'null_value'
  confidenceScore Decimal?                 @map("confidence_score") @db.Decimal(3, 2)

  // Audit
  verifiedBy String?   @map("verified_by") // 'agent', 'user:{id}', 'system'
  verifiedAt DateTime? @map("verified_at")
  auditNotes String?   @map("audit_notes")

  createdAt DateTime        @default(now()) @map("created_at")
  run       VerificationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId], map: "idx_verification_run")
  @@index([carrier], map: "idx_verification_carrier")
  @@index([status], map: "idx_verification_status")
  @@map("verification_results")
}

model ExpectedValue {
  id            String   @id @default(cuid())
  documentPath  String   @map("document_path") // Path to source PDF
  customerName  String?  @map("customer_name") // For reference
  carrier       String
  fieldName     String   @map("field_name")
  expectedValue String   @map("expected_value")
  source        String? // 'pdf_manual_entry', 'eop_document'
  enteredBy     String?  @map("entered_by")
  enteredAt     DateTime @default(now()) @map("entered_at")

  @@unique([documentPath, fieldName], map: "expected_values_document_field_key")
  @@index([carrier], map: "idx_expected_carrier")
  @@map("expected_values")
}

// ============================================================================
// PRICE LIST AUDITING SYSTEM MODELS
// Track audit runs, validation results, and regeneration attempts
// ============================================================================

model PriceListAudit {
  id              String           @id @default(cuid())
  customerId      String           @map("customer_id")
  authorizationId String           @map("authorization_id")
  carrier         String
  planName        String?          @map("plan_name")
  status          AuditStatus      @default(PENDING)
  triggeredBy     AuditTriggerType @map("triggered_by") // DOCUMENT_UPLOAD, MANUAL, SCHEDULED
  auditStartTime  DateTime         @default(now()) @map("audit_start_time")
  auditEndTime    DateTime?        @map("audit_end_time")

  // Summary metrics
  totalRules   Int      @default(0) @map("total_rules")
  passedRules  Int      @default(0) @map("passed_rules")
  failedRules  Int      @default(0) @map("failed_rules")
  warningRules Int      @default(0) @map("warning_rules")
  passRate     Decimal? @map("pass_rate") @db.Decimal(5, 2)

  // Regeneration tracking
  autoRegenerationAttempts Int     @default(0) @map("auto_regeneration_attempts")
  lastRegenerationResult   String? @map("last_regeneration_result") // SUCCESS, STILL_FAILING

  // Audit details
  findings       Json @default("[]") // Array of findings summary
  criticalIssues Int  @default(0) @map("critical_issues")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customer         Customer                   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  authorization    InsuranceAuthorization     @relation(fields: [authorizationId], references: [id], onDelete: Cascade)
  results          AuditResult[]
  regenerationLogs PriceListRegenerationLog[]

  @@index([customerId], map: "idx_audit_customer")
  @@index([authorizationId], map: "idx_audit_authorization")
  @@index([status], map: "idx_audit_status")
  @@index([carrier], map: "idx_audit_carrier")
  @@index([createdAt], map: "idx_audit_created")
  @@map("price_list_audits")
}

model AuditResult {
  id      String            @id @default(cuid())
  auditId String            @map("audit_id")
  ruleId  String            @map("rule_id")
  status  AuditResultStatus // PASS, FAIL, WARNING

  // Rule info
  ruleName     String            @map("rule_name")
  ruleCategory AuditRuleCategory @map("rule_category") // ACCURACY, COMPLETENESS, CONSISTENCY
  carrier      String

  // What was checked
  fieldChecked  String  @map("field_checked") // e.g., 'frame_copay_accuracy', 'lens_product_completeness'
  expectedValue String? @map("expected_value") // What should be true
  actualValue   String? @map("actual_value") // What we found

  // Issue details
  severity      Decimal? @db.Decimal(5, 2) // 1.0 = critical, 0.5 = warning
  details       Json     @default("{}") // Detailed error info
  affectedCount Int?     @map("affected_count") // e.g., 5 frames missing prices

  createdAt DateTime @default(now()) @map("created_at")

  audit PriceListAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId], map: "idx_result_audit")
  @@index([ruleId], map: "idx_result_rule")
  @@index([status], map: "idx_result_status")
  @@map("audit_results")
}

model AuditRule {
  id          String            @id @default(cuid())
  name        String            @unique
  category    AuditRuleCategory // ACCURACY, COMPLETENESS, CONSISTENCY
  carrier     String? // VSP, EYEMED, SPECTERA, or null for ALL
  description String?

  // Rule execution
  ruleCode  String // Function name/identifier
  ruleLogic String? // Description of validation logic

  // Rule configuration
  enabled     Boolean @default(true)
  criticality Decimal @default(1) @db.Decimal(3, 2) // 1.0 = critical failure, 0.5 = warning

  // Metadata
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  @@index([carrier], map: "idx_rule_carrier")
  @@index([category], map: "idx_rule_category")
  @@index([enabled], map: "idx_rule_enabled")
  @@map("audit_rules")
}

model PriceListRegenerationLog {
  id              String @id @default(cuid())
  auditId         String @map("audit_id")
  customerId      String @map("customer_id")
  authorizationId String @map("authorization_id")

  // Regeneration attempt tracking
  attemptNumber      Int      @map("attempt_number") // 1, 2, or 3
  regeneratedAt      DateTime @default(now()) @map("regenerated_at")
  regenerationResult String   @map("regeneration_result") // SUCCESS, STILL_FAILING

  // What happened
  errorMessage String? @map("error_message")
  details      Json    @default("{}") // Detailed result info

  // Re-audit after regeneration
  subsequentAuditId String? @map("subsequent_audit_id") // Link to re-audit that ran after regeneration

  createdAt DateTime @default(now()) @map("created_at")

  audit PriceListAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId], map: "idx_regen_audit")
  @@index([customerId], map: "idx_regen_customer")
  @@map("price_list_regeneration_logs")
}

// ============================================================================
