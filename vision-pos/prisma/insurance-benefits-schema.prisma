// Insurance Benefits and Eligibility Models
// Add these to your main schema.prisma file

model InsuranceBenefit {
  id              String   @id @default(cuid())
  customerId      String
  carrier         String   // VSP, EyeMed, Spectera, etc.
  planYear        Int      // 2024, 2025, etc.
  effectiveDate   DateTime
  expirationDate  DateTime
  
  // Exam Benefits
  examCopay       Float    @default(0)
  examCovered     Boolean  @default(true)
  examFrequency   Int      @default(12) // months
  lastExamDate    DateTime?
  nextExamDate    DateTime?
  
  // Materials Benefits
  materialsCopay  Float    @default(0)
  materialsFrequency Int   @default(24) // months
  lastMaterialsDate DateTime?
  nextMaterialsDate DateTime?
  
  // Frame Allowance
  frameAllowance  Float    @default(0)
  frameAllowanceUsed Float @default(0)
  frameAllowanceRemaining Float @default(0)
  
  // Lens Allowance
  lensAllowance   Float    @default(0)
  lensAllowanceUsed Float  @default(0)
  lensAllowanceRemaining Float @default(0)
  
  // Contact Lens Benefits
  contactAllowance Float   @default(0)
  contactAllowanceUsed Float @default(0)
  contactAllowanceRemaining Float @default(0)
  contactFittingCopay Float @default(0)
  contactFrequency Int     @default(12) // months
  lastContactsDate DateTime?
  nextContactsDate DateTime?
  
  // Additional Benefits
  additionalAllowances Json? // Store other carrier-specific benefits
  
  // Status
  isActive        Boolean  @default(true)
  verifiedDate    DateTime?
  verifiedBy      String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  customer        Customer @relation(fields: [customerId], references: [id])
  transactions    BenefitTransaction[]
  
  @@map("insurance_benefits")
  @@index([customerId])
  @@index([carrier, planYear])
}

model BenefitTransaction {
  id              String   @id @default(cuid())
  benefitId       String
  customerId      String
  transactionType BenefitTransactionType
  category        BenefitCategory
  
  // Transaction Details
  amount          Float
  description     String
  productIds      Json?    // Array of product IDs used
  orderId         String?
  
  // Allowance Impact
  allowanceUsed   Float    @default(0)
  allowanceRemaining Float @default(0)
  
  // Date tracking
  serviceDate     DateTime
  processedDate   DateTime @default(now())
  
  createdAt       DateTime @default(now())
  
  // Relations
  benefit         InsuranceBenefit @relation(fields: [benefitId], references: [id])
  customer        Customer @relation(fields: [customerId], references: [id])
  
  @@map("benefit_transactions")
  @@index([benefitId])
  @@index([customerId])
  @@index([serviceDate])
}

enum BenefitTransactionType {
  USAGE          // Benefit used
  RESET          // Annual reset
  ADJUSTMENT     // Manual adjustment
  VERIFICATION   // Eligibility check
}

enum BenefitCategory {
  EXAM
  FRAMES
  LENSES
  CONTACTS
  MATERIALS
  OTHER
}

model EligibilityCheck {
  id              String   @id @default(cuid())
  customerId      String
  carrier         String
  memberId        String
  
  // Check Results
  isEligible      Boolean
  eligibilityDate DateTime
  expirationDate  DateTime?
  
  // Benefits Found
  benefitsJson    Json     // Full benefit details from verification
  
  // Exam Eligibility
  examEligible    Boolean  @default(false)
  examNextDate    DateTime?
  
  // Materials Eligibility
  materialsEligible Boolean @default(false)
  materialsNextDate DateTime?
  
  // Contacts Eligibility
  contactsEligible Boolean @default(false)
  contactsNextDate DateTime?
  
  // Verification Details
  verificationMethod String? // Manual, API, Phone, etc.
  verifiedBy      String?
  notes           String?
  
  createdAt       DateTime @default(now())
  
  // Relations
  customer        Customer @relation(fields: [customerId], references: [id])
  
  @@map("eligibility_checks")
  @@index([customerId])
  @@index([createdAt])
}

model InsuranceTierMapping {
  id              String   @id @default(cuid())
  carrier         String   // VSP, EyeMed, Spectera
  tierCode        String   // K, J, F, O, N for VSP
  tierName        String   // Standard, Premium, etc.
  
  // Discount/Coverage
  discountPercent Float    // 30%, 40%, 50%, etc.
  copayAmount     Float?   // Fixed copay if applicable
  
  // Descriptions
  description     String?
  benefits        Json?    // Additional benefit details
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([carrier, tierCode])
  @@map("insurance_tier_mappings")
}
