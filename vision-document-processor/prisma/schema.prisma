generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

// This app only manages InsuranceDocument
// Customer table exists in POS app's schema

model InsuranceDocument {
  id              String   @id @default(cuid())
  customerId      String   // References Customer from POS app
  
  // Document metadata
  documentType    DocumentType
  description     String?
  uploadedAt      DateTime @default(now())
  uploadedBy      String?  // Staff user ID
  
  // File storage
  imageUrl        String   // Path to stored image
  thumbnailUrl    String?  // Smaller preview
  fileName        String
  fileSize        Int
  mimeType        String   // image/jpeg, image/png, application/pdf
  
  // Processing status
  processingStatus ProcessingStatus @default(PENDING)
  processedAt     DateTime?
  processingError String?  @db.Text
  
  // Google Document AI results
  googleOcrText   String?  @db.Text
  googleOcrData   Json?    // Full structured response
  googleConfidence Float?
  
  // GPT-4 Vision extraction
  gptExtractedData Json?   // Full structured extraction
  gptProcessedAt  DateTime?
  gptTokensUsed   Int?
  gptCost         Float?
  
  // Extracted insurance fields with confidence scores
  carrier         String?
  carrierConfidence Float?
  memberId        String?
  memberIdConfidence Float?
  groupNumber     String?
  groupConfidence Float?
  planName        String?
  planTier        String?
  
  // Extracted benefit amounts
  eligibilityDate DateTime?
  examCopay       Float?
  materialsCopay  Float?
  frameAllowance  Float?
  lensAllowance   Float?
  contactAllowance Float?
  overagePercentage Float?
  
  // Authorization form specific
  isAuthorization Boolean  @default(false)
  authNumber      String?
  authExpiryDate  DateTime?
  approvedServices Json?
  authNotes       String?  @db.Text
  
  // Field-level confidence tracking
  lowConfidenceFields Json?  // Array of field names that need review
  
  // Staff verification
  needsReview     Boolean  @default(false)
  reviewedBy      String?
  reviewedAt      DateTime?
  correctionsMade Json?    // Track what staff corrected
  staffNotes      String?  @db.Text
  
  // Applied to customer profile
  appliedToCustomer Boolean @default(false)
  appliedAt       DateTime?
  appliedBy       String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([customerId, uploadedAt])
  @@index([processingStatus])
  @@index([appliedToCustomer])
  @@map("insurance_documents")
}

enum DocumentType {
  INSURANCE_CARD_FRONT
  INSURANCE_CARD_BACK
  AUTHORIZATION_FORM
  ELIGIBILITY_VERIFICATION
  EOB
  OTHER
}

enum ProcessingStatus {
  PENDING          // Uploaded, not yet processed
  PROCESSING_GOOGLE // Currently running Google Document AI
  PROCESSING_GPT   // Currently running GPT-4 Vision
  READY_FOR_REVIEW // Processed, waiting for staff review
  VERIFIED         // Staff has reviewed and approved
  FAILED           // Processing failed
  ARCHIVED         // Old document, kept for records
}
